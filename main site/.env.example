NODE_ENV=production
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# One host, or several tried in order. On the same Hostinger plan, start with localhost.
DB_HOST=localhost,auth-db1800.hstgr.io
DB_PORT=3306
DB_ACCOUNT_PREFIX=u531106610
DB_NAME=Altis
DB_USER=mukisa
DB_PASSWORD=your-hostinger-database-password

# Public site URL used for canonical links, Open Graph tags and the sitemap.
SITE_URL=https://altistravels.com

# Optional tracking. Leave empty until the accounts exist. Nothing loads until a visitor accepts
# the cookie banner, and the banner only appears once at least one ID is set.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel ID, digits only
META_PIXEL_ID=
# Google Search Console "HTML tag" verification token (the content="..." value only)
GOOGLE_SITE_VERIFICATION=
