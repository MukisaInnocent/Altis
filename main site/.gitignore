# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.tsbuildinfo
.nuxt/
.output/
coverage/

# PocketBase runtime data and Windows executable
pb_data/
pb_data_local/
pocketbase.exe

# The Linux PocketBase executable is required by the production Node app.
!apps/pocketbase/pocketbase

# Vite
.vite/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Temporary
tmp/
temp/
*.tmp

# Archives (for deployment)
*.zip
*.tar
*.tar.gz
*.tgz

# Deployment staging
deploy-staging/
hostinger-deploy/
# Next.js build output.
# Committing this hides build failures: when `next build` breaks on the host, the stale
# committed bundle keeps being served and the app silently runs old code.
.next/
out/

# Local SQLite database and its WAL sidecar files.
# On Hostinger the data lives in MySQL, so these must never ship.
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Runtime user uploads
uploads/*
!uploads/.gitkeep

# Credential dumps.
# A stray file named like "DB_HOST=auth-db123.hstgr.env" once leaked the live database
# password into this repository. Keep blocking that pattern.
.env
.env.*
!.env.example
*DB_HOST*
*DB_PASSWORD*
*DB_USER*
*DB_NAME*
*auth-db*.env
